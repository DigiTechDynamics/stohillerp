# ─── docker compose environment ──────────────────────────────────────────────
# Copy to .env (git-ignored) next to docker-compose.yml.

# REQUIRED. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

POSTGRES_DB=stohill_erp
POSTGRES_USER=stohill

# Hostnames/origins the site is served from.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080

# Local HTTP only: set to False. Keep True behind HTTPS in production.
DJANGO_SECURE_SSL_REDIRECT=False

WEB_PORT=8080
GUNICORN_WORKERS=3
LOG_LEVEL=INFO
LOG_FORMAT=json
TIME_ZONE=Africa/Harare

# Outgoing email: portal invitations, payslips, statements, rent reminders.
# Without these, emails are only written to the api/scheduler logs.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Tenant portal: the public URL of this site, and Paynow credentials.
PORTAL_BASE_URL=http://localhost:8080
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
# Bank account code that receives online payments (default: first active account)
ONLINE_PAYMENTS_BANK_ACCOUNT=

# Backups (docker compose 'backup' service)
# BACKUP_DIR=./backups
# BACKUP_AT=01:30
# BACKUP_KEEP_DAYS=14

# Error monitoring: errors and failed scheduled jobs are reported to Sentry.
# Also point an uptime monitor at https://<your-domain>/api/v1/health/
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Company details printed on invoices, statements and payslips (blank = left out).
# A VAT-registered business must show its VAT number on tax invoices.
COMPANY_NAME=Stohill Properties
COMPANY_TAGLINE=
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_WEBSITE=
COMPANY_VAT_NUMBER=
COMPANY_TAX_NUMBER=
