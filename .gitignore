.env
.env.*
!.env.example
local_settings.py

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
backend/staticfiles/
backend/media/
backend/logs/
*.sqlite3
*.sqlite3-journal

