# ─── Stohill ERP backend environment ─────────────────────────────────────────
# Copy to backend/.env for local work. NEVER commit a real .env.

# Django
DJANGO_SECRET_KEY=change-me-generate-with-python-c-secrets-token-urlsafe-64
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Database (PostgreSQL only)
DATABASE_URL=postgres://stohill:stohill@localhost:5432/stohill_erp
DB_CONN_MAX_AGE=60

# CORS (only needed if the SPA runs on a different origin than the API)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT lifetimes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Rate limits (DRF format: N/sec|min|hour|day)
THROTTLE_ANON=60/min
THROTTLE_USER=600/min
THROTTLE_LOGIN=10/min

# Logging: LOG_FORMAT is "verbose" (human) or "json" (aggregators)
LOG_LEVEL=INFO
LOG_FORMAT=verbose

# Company
TIME_ZONE=Africa/Harare
COMPANY_NAME=Stohill Properties
# Printed on documents (blank = left out); VAT number is required on tax invoices
# COMPANY_TAGLINE=
# COMPANY_ADDRESS=
# COMPANY_PHONE=
# COMPANY_EMAIL=
# COMPANY_WEBSITE=
# COMPANY_VAT_NUMBER=
# COMPANY_TAX_NUMBER=
COMPANY_CURRENCY=USD
COMPANY_COUNTRY=ZW
COMPANY_FISCAL_START_MONTH=3

# Demo seed passwords (only used by `manage.py seed_demo`; random if unset)
# SEED_ADMIN_PASSWORD=
# SEED_EXEC_PASSWORD=

# Email (console backend prints emails to the log in development).
# For real delivery: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@stohill.local
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# Tenant portal and online payments. PORTAL_BASE_URL is the public address of
# the SPA (activation and payment-return links point there).
PORTAL_BASE_URL=http://localhost:5173
# "test" completes payments without money moving (development only; forced off in production)
PAYMENT_GATEWAY=test
# PAYNOW_INTEGRATION_ID=
# PAYNOW_INTEGRATION_KEY=
# Bank account code that receives online payments (default: first active account)
# ONLINE_PAYMENTS_BANK_ACCOUNT=

# Purchasing: largest % difference between invoice and PO price that still matches
# PO_PRICE_TOLERANCE_PCT=2

# Error monitoring (optional): report errors to Sentry
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
