# Stohil Properties - Frontend Environment Variables
# Copy this file to .env and fill in the values

# ─── API Configuration ────────────────────────────────────────────────────────
# In development, Vite's proxy (vite.config.js) handles /api -> localhost:8000
VITE_API_BASE_URL=http://localhost:8000/api/v1/

# ─── Feature Flags ────────────────────────────────────────────────────────────
VITE_ENABLE_ANALYTICS=false
VITE_APP_NAME="Stohil ERP"
