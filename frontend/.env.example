# Stohill ERP - frontend environment. Copy to .env.local (git-ignored).

# Leave unset to call the API on the same origin (/api/v1/): Vite proxies it in
# dev and nginx proxies it in the Docker/production setup. Only set this if the
# API is hosted on a different origin (then also set CORS_ALLOWED_ORIGINS).
# VITE_API_BASE_URL=https://api.example.com/api/v1/

VITE_APP_NAME="Stohill ERP"
